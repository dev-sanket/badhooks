{
  "name": "badhooks",
  "version": "0.1.0",
  "description": "Deliver deliberately broken Stripe webhook sequences to a local endpoint",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "bin": {
    "badhooks": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "badhooks": "tsx src/cli.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
